# Copy to .env and fill in. The real .env is gitignored — never commit it.
# Parsed by docker compose, not the shell: values may contain spaces and
# parentheses unquoted. This is not a shell script — never `source` it.

# Interface every service binds to on the host.
# VM: the Tailscale IP (deploy/setup.sh fills this in via `tailscale ip -4`).
# Local dev: leave as loopback.
BIND_IP=127.0.0.1

# Where the worker/MCP containers find the database (inside the container).
FLEET_DB=/data/fleet.db

# Self-hosted ntfy (the compose service) — worker reaches it on the internal network.
NTFY_URL=http://ntfy
NTFY_TOPIC=fleet-alerts
# Token for the ntfy user you create post-deploy (README "ntfy auth" step).
NTFY_TOKEN=

# Worker tuning
FLEET_TICK_SECONDS=5
FLEET_FAIL_THRESHOLD=3
FLEET_DOMAIN_MIN_GAP=2.0
FLEET_MAX_CONCURRENT=20
FLEET_USER_AGENT=fleet-watcher/0.1 (personal monitoring)
FLEET_HEALTH_PORT=8686

# MCP server
FLEET_MCP_HOST=0.0.0.0
FLEET_MCP_PORT=8765

# Timezone job schedules are interpreted in by default
FLEET_TZ=America/New_York

# Jobs engine
FLEET_JOBS_MAX_CONCURRENT=5
FLEET_GRACE_SECONDS=3600
FLEET_DEFER_SECONDS=3600
FLEET_CLAUDE_MAX_RUNS_PER_DAY=24

# Headless Claude auth: run `claude setup-token` on your Mac, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# LLM fallback (OpenAI-compatible; OpenRouter free tier). Comma-separated
# model list — OpenRouter fails over across them server-side.
FLEET_FALLBACK_LLM_URL=https://openrouter.ai/api/v1
FLEET_FALLBACK_LLM_KEY=
# First id is the default; the rest are OpenRouter's server-side failover, so
# list several - free capacity is shared and 429s are routine. OpenRouter
# accepts at most 3 ids in that array; extras are configured harmlessly but
# never reach the wire. Only ids ending
# in ":free" cost nothing; buying $10 of credit once raises the free quota
# from 50 to 1000 requests/day. openrouter/free routes to whatever free model
# is up, which makes it a good last entry.
FLEET_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,openrouter/free

# Scrape transport (watchers with fetch_via="scrape"): any rendering / anti-bot
# service that takes JSON and returns the page. Empty URL disables it.
#   Firecrawl (self-hosted): http://host.docker.internal:3999/v2/scrape
#   Firecrawl (cloud):       https://api.firecrawl.dev/v2/scrape
#   browserless:             http://browserless:3000/content?token=CHANGEME
FLEET_SCRAPE_URL=
FLEET_SCRAPE_KEY=
# Defaults suit Firecrawl v2. maxAge=0 is load-bearing — Firecrawl serves cached
# pages by default, and a monitor fed from a cache never sees a change.
# For a renderer that returns raw HTML (browserless), set FLEET_SCRAPE_PATH empty.
# FLEET_SCRAPE_BODY={"url": "{{url}}", "formats": ["markdown"], "onlyMainContent": true, "maxAge": 0}
# FLEET_SCRAPE_PATH=data.markdown
FLEET_SCRAPE_TIMEOUT=120
FLEET_SCRAPE_MAX_PER_DAY=0
FLEET_SCRAPE_MAX_CONCURRENT=3
