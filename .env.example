# Copy to .env and fill in. The real .env is gitignored — never commit it.

# Interface every service binds to on the host.
# VM: the Tailscale IP (deploy/setup.sh fills this in via `tailscale ip -4`).
# Local dev: leave as loopback.
BIND_IP=127.0.0.1

# Where the worker/MCP containers find the database (inside the container).
FLEET_DB=/data/fleet.db

# Self-hosted ntfy (the compose service) — worker reaches it on the internal network.
NTFY_URL=http://ntfy
NTFY_TOPIC=fleet-alerts
# Token for the ntfy user you create post-deploy (README "ntfy auth" step).
NTFY_TOKEN=

# Worker tuning
FLEET_TICK_SECONDS=5
FLEET_FAIL_THRESHOLD=3
FLEET_DOMAIN_MIN_GAP=2.0
FLEET_MAX_CONCURRENT=20
FLEET_USER_AGENT=fleet-watcher/0.1 (personal monitoring)
FLEET_HEALTH_PORT=8686

# MCP server
FLEET_MCP_HOST=0.0.0.0
FLEET_MCP_PORT=8765
